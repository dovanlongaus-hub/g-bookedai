{
  "name": "@bookedai/drive-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-sync project documents, progress reports, and analytics to CEO Google Drive",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "sync": "tsx src/cli/sync-now.ts",
    "report:daily": "tsx src/cli/generate-daily.ts",
    "report:weekly": "tsx src/cli/generate-weekly.ts"
  },
  "dependencies": {
    "@bookedai/shared": "workspace:*",
    "@bookedai/db": "workspace:*",
    "@bookedai/google": "workspace:*",
    "@google-cloud/scheduler": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "googleapis": "^144.0.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
