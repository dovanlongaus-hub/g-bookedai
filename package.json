{
  "name": "bookedai",
  "version": "0.1.0",
  "private": true,
  "description": "bookedai.au — AI Revenue Engine Platform",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @bookedai/api dev",
    "dev:agent": "pnpm --filter @bookedai/agent dev",
    "dev:web": "pnpm --filter @bookedai/web-g dev",
    "dev:longcare": "pnpm --filter @bookedai/web-longcare dev",
    "dev:booking": "pnpm --filter @bookedai/booking-web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @bookedai/db migrate",
    "db:seed": "pnpm --filter @bookedai/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "drive:sync": "pnpm --filter @bookedai/drive-sync sync",
    "drive:daily": "pnpm --filter @bookedai/drive-sync report:daily",
    "drive:weekly": "pnpm --filter @bookedai/drive-sync report:weekly",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "turbo": "^2.9.8"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@tremor/react": "^3.18.7",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "nuqs": "^2.8.9",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zustand": "^5.0.13"
  }
}
