# Public site config
NEXT_PUBLIC_SITE_URL=https://longcare.au
NEXT_PUBLIC_CONTACT_EMAIL=hello@longcare.au

# API base (longcare's backend on api.g.bookedai.au)
API_URL=https://api.g.bookedai.au

# CORS allowlist (used by middleware)
ALLOWED_ORIGINS=https://longcare.au,https://book.longcare.au,https://app.longcare.au

# Firebase (Sprint P1 — uncomment when project created)
