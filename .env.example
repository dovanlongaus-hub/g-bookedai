# ===== App =====
NODE_ENV=development
APP_BASE_URL=https://g.bookedai.au
LONGCARE_BASE_URL=https://longcare.au
API_BASE_URL=https://api.g.bookedai.au

# ===== Google Cloud =====
GOOGLE_CLOUD_PROJECT=longcare-prod
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Google Workspace =====
CEO_EMAIL=ceo@longcare.au
MENTOR_EMAIL=ceo@longcare.au

# ===== Google Drive Folders =====
LONGCARE_DRIVE_ROOT_FOLDER_ID=
LONGCARE_DRIVE_TRANSCRIPTS_FOLDER_ID=
LONGCARE_DRIVE_NOTES_FOLDER_ID=
LONGCARE_DRIVE_MARKETING_FOLDER_ID=
LONGCARE_DRIVE_INVOICES_FOLDER_ID=
LONGCARE_DRIVE_NOTEBOOKS_FOLDER_ID=

# ===== Google Cloud Services =====
CLOUD_SCHEDULER_LOCATION=australia-southeast1
CLOUD_TASKS_LOCATION=australia-southeast1
CLOUD_TASKS_QUEUE=bookedai-default
BIGQUERY_DATASET=bookedai_analytics

# ===== Database =====
DATABASE_URL=postgresql://bookedai:localpass@localhost:5432/longcare
FIRESTORE_DATABASE=(default)

# ===== Stripe =====
# In production, sk_live_* keys are loaded from Google Secret Manager — never commit them.
# In development, use sk_test_* from Stripe Dashboard → Test mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT=https://book.longcare.au/webhooks/stripe
# Comma-separated. Each method must be enabled in Stripe Dashboard → Payment methods.
# AU defaults: card,afterpay_clearpay,zip
STRIPE_PAYMENT_METHODS=card,afterpay_clearpay,zip

# ===== Bank Transfer (Australia) =====
BANK_TRANSFER_PAYID=ceo@longcare.au
BANK_TRANSFER_BSB=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=Van Do
BANK_TRANSFER_BANK_NAME=Westpac

# ===== BPAY =====
# Apply at https://www.bpay.com.au/business/becoming-a-biller for a Biller Code.
BPAY_BILLER_CODE=

# ===== VietQR (Vietnam — for VND-paying customers) =====
# Bank BIN list: https://api.vietqr.io/v2/banks  (e.g. 970436=VCB, 970422=MB)
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

# ===== Pay-on-Arrival (Book now, pay at appointment) =====
PAY_ON_ARRIVAL_ENABLED=true

# ===== Frontend (booking-web) — baked at build time =====
# These appear in the customer-facing QR code and bank-details panel.
NEXT_PUBLIC_BANK_NAME=Westpac
NEXT_PUBLIC_BANK_PAYID=ceo@longcare.au
NEXT_PUBLIC_BANK_BSB=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Van Do
NEXT_PUBLIC_VIETQR_BANK_CODE=VCB
NEXT_PUBLIC_VIETQR_ACCOUNT_NUMBER=
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=

# ===== Xero =====
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# ===== Analytics =====
GA4_MEASUREMENT_ID=
GTM_ID=

# ===== WhatsApp Business API =====
WHATSAPP_VERIFY_TOKEN=bookedai-whatsapp-verify-2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
